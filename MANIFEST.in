# Include C source files. The headers matter as much as the .c: dtype_table.h
# is generated from zdata/dtypes.py and #included by both tools, so omitting it
# breaks compilation from an sdist.
include ctools/*.c
include ctools/*.h

# Include README, LICENSE and changelog
include README.md
include LICENSE
include CHANGELOG.md

# Include default gene list (required for alignment)
include files/2ks10c_genes.txt

# Include package data
recursive-include core *.py
recursive-include build_zdata *.py
recursive-include ctools *.c
recursive-include ctools *.h

# Compiled binaries are deliberately NOT shipped in the sdist.
#
# An sdist is compiled on the target platform, so a bundled binary is at best
# redundant and at worst harmful: setup.py falls back to a pre-compiled binary
# when ZSTD is unavailable, and on a different platform that fallback would
# happily install a binary that cannot execute there ("Exec format error"),
# instead of failing with a clear "install ZSTD" message.
#
# Platform wheels (built by cibuildwheel, correctly tagged per platform) are
# where pre-built binaries belong.

# Exclude compiled binaries from git (but include in distribution)
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude *.so
global-exclude *.dylib
global-exclude *.dll

